# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# Postgres. Локально – Docker (pnpm db:up), на Vercel – переменные от интеграции Neon.
DATABASE_URL=postgres://kvarta:kvarta@localhost:5433/kvarta
# Для миграций (drizzle-kit). На Vercel – прямое подключение Neon без пулера.
DATABASE_URL_UNPOOLED=postgres://kvarta:kvarta@localhost:5433/kvarta
# Отдельная база для integration-тестов
DATABASE_URL_TEST=postgres://kvarta:kvarta@localhost:5433/kvarta_test

# Соль для хеша IP (лимит заявок). Сгенерировать: openssl rand -hex 32
IP_HASH_SALT=

# Telegram. Пусто – уведомления пропускаются, заявка всё равно сохраняется.
# На Vercel задаём только для Production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Адрес сайта для metadata и OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000
